<section class="hero esq-tinta" style="min-height:100svh">
  <div class="wrap hero__grid">
    <div class="header__logo" style="width:180px;color:var(--hueso)">{% render 'logo-svg', id: 'p' %}</div>
    <h1 class="d hero__title" style="font-size:clamp(4rem,22vw,18rem)">{{ section.settings.title }}</h1>
    <div class="hero__foot" style="display:grid;gap:16px">
      <p class="txt-l">{{ section.settings.text }}</p>
      {%- form 'customer', class: 'newsletter' -%}
        <input type="hidden" name="contact[tags]" value="lista-espera">
        <label class="visually-hidden" for="pw-email">{{ 'general.email' | t }}</label>
        <input id="pw-email" type="email" name="contact[email]" required placeholder="{{ 'general.email' | t }}">
        <button class="btn" type="submit">{{ 'general.subscribe' | t }}</button>
      {%- endform -%}
      <details><summary class="kicker">{{ 'password.enter' | t }}</summary>
        {%- form 'storefront_password', class: 'newsletter' -%}
          <label class="visually-hidden" for="pw">{{ 'password.password' | t }}</label>
          <input id="pw" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
          <button class="btn" type="submit">{{ 'password.enter' | t }}</button>
          {%- if form.errors -%}<p role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endform -%}
      </details>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Contraseña",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Aguanta. Ya casi." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Estamos terminando el Drop 01. Déjanos tu correo y te avisamos el día que abramos." }
  ]
}
{% endschema %}
