<section class="section">
  <div class="wrap">
    <h1 class="d d-xl" style="margin-bottom:24px">{{ blog.title }}</h1>
    {%- paginate blog.articles by 12 -%}
      <ul class="pgrid" role="list">
        {%- for article in blog.articles -%}
          <li><a class="card" href="{{ article.url }}">
            <div class="card__media">{%- if article.image -%}{% render 'image', image: article.image, sizes: '(min-width: 750px) 33vw, 50vw', alt: article.title %}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}</div>
            <div class="card__body"><h2 class="card__title">{{ article.title }}</h2><p class="muted" style="margin:0">{{ article.published_at | date: format: 'date' }}</p></div>
          </a></li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}{ "name": "Blog", "settings": [] }{% endschema %}
