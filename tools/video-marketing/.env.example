# ── Voz en off (opcional) ────────────────────────────────────────────
# Sin estas dos, los scripts generan pistas de silencio y el montaje se
# puede revisar igualmente.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # voz ES-ES · p.ej. 'Marta' o 'David'
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Tomas de vídeo IA (solo para los reels cinematic) ────────────────
# Formato fal.ai: <UUID>:<hex> · https://fal.ai/dashboard/keys
# Sin esta clave usa `npm run cine:shots-dry` (placeholders, 0 €).
FAL_KEY=
